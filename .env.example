# Prime Detail - Environment Variables
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://primedetail.com
NEXT_PUBLIC_SITE_NAME=Prime Detail

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Booking System
BOOKING_API_ENDPOINT=https://api.primedetail.com/v1/bookings
BOOKING_API_KEY=your_booking_api_key_here

# Email Service (SendGrid, Resend, etc.)
EMAIL_SERVICE_API_KEY=your_email_service_key
EMAIL_FROM=noreply@primedetail.com
EMAIL_TO=bookings@primedetail.com

# SMS Notifications (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+12145550199

# reCAPTCHA (for booking form)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# CMS (Optional - for content management)
CMS_API_URL=https://cms.primedetail.com/api
CMS_API_TOKEN=your_cms_token

# Feature Flags
NEXT_PUBLIC_ENABLE_BOOKING=true
NEXT_PUBLIC_ENABLE_GALLERY=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Performance
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true
NEXT_PUBLIC_LAZY_LOAD_IMAGES=true